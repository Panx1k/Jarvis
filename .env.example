# Скопируйте этот файл в .env и заполните нужные значения.
# .env не должен попадать в git (он уже в .gitignore).

# --- AI Brain: Google Gemini (бесплатно, рекомендуется) ---
# Ключ: https://aistudio.google.com/apikey (из России — с включённым VPN). Можно несколько: GEMINI_API_KEY_2, …
GEMINI_API_KEY=
# Пусто — JARVIS сам выберет актуальную gemini-*-flash из доступных ключу
GEMINI_MODEL=
GEMINI_REASONING_EFFORT=none
# Живой голос (Gemini Live): модель сама слушает и отвечает голосом. 1 — включён по умолчанию (переключатель в окне)
GEMINI_LIVE=1
# Модель: пусто — автоподбор (самая новая *-live). Голос: Charon, Puck, Kore, Fenrir, Aoede, Orus, Zephyr, Leda
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=Charon
# Через сколько секунд тишины разговор закрывается и JARVIS снова ждёт «Jarvis»
LIVE_IDLE_SECONDS=30
# Перебивание голосом, пока JARVIS говорит (1/0). Если JARVIS сам себя обрывает (громкие колонки) —
# увеличьте LIVE_BARGE_IN_RATIO (во сколько раз голос должен быть громче эха колонок) или наденьте наушники
LIVE_BARGE_IN=1
LIVE_BARGE_IN_RATIO=1.8

# --- Spotify (полная интеграция через официальный Web API) ---
# 1) https://developer.spotify.com/dashboard → Create app; Redirect URI: http://127.0.0.1:8765/callback; API: Web API
# 2) Client ID — сюда (client secret не нужен). 3) «Jarvis, подключи Spotify» или python main.py --spotify-login
# Вход хранится зашифрованным (Windows DPAPI) в config/spotify_token.bin. Управление плеером требует Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# --- Голосовые записи JARVIS (Voice Sample System) ---
# Папки: Samples/ и assets/voice_samples/<категория>/; смысл записей — assets/voice_samples/index.json.
# Подходящий по смыслу ответ звучит записью, остальное — обычным TTS. Файлы только проигрываются. 0 — выключить
SAMPLES=1
SAMPLES_DIR=Samples
# Приветствие записью при запуске
SAMPLES_GREETING=1
# Порог уверенности (0..1): ниже — обычный TTS; от VOICE_SAMPLE_MIN до порога — только если совпало намерение
VOICE_SAMPLE_THRESHOLD=0.80
VOICE_SAMPLE_MIN=0.60
# Отладка выбора записей в ленте событий (или «Режим разработчика» в настройках)
JARVIS_DEBUG=0
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.3

# --- AI Brain: OpenAI или локальная модель Ollama (запасной мозг при LLM_PROVIDER=gemini) ---
# Ключи: https://platform.openai.com/api-keys — хранятся только здесь, в коде, логах и интерфейсе их нет.
# Можно указать несколько СВОИХ ключей (например, разных проектов): при исчерпании квоты, rate limit или
# недействительном ключе JARVIS переключается на следующий. Номеров сколько угодно: _6, _7, …
OPENAI_API_KEY_1=your_api_key_here
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_API_KEY_5=
# Один ключ без номера тоже поддерживается (используется в дополнение к нумерованным)
# OPENAI_API_KEY=
# Паузы для ключей (секунды): после rate limit / после исчерпания квоты / после повторяющихся ошибок сервера
OPENAI_RATE_LIMIT_COOLDOWN=30
OPENAI_QUOTA_COOLDOWN=1800
OPENAI_ERROR_COOLDOWN=60
# Повторы на одном ключе при временных ошибках (с экспоненциальной паузой)
OPENAI_MAX_RETRIES=2
# Имя модели (обязательно; в коде не зашито), например модель с поддержкой function calling
OPENAI_MODEL=
# Необязательно: 0.0–2.0. Пусто — значение модели по умолчанию (некоторые модели не принимают параметр)
OPENAI_TEMPERATURE=
# Необязательно: совместимый шлюз/прокси для OpenAI API
OPENAI_BASE_URL=

# Какой LLM использовать: gemini (если недоступен — OPENAI_* как запасной) | openai | anthropic
LLM_PROVIDER=gemini
# llm    — команды решает AI Brain (локальные правила — только если API недоступен)
# hybrid — уверенные простые команды выполняются локально мгновенно, остальное — AI Brain
# rules  — только локальные правила, без облака
BRAIN_MODE=llm

# --- AI Brain: Claude (если LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=low
LLM_WEB_SEARCH=1
LLM_FALLBACKS=1

# --- Голосовой режим ---
# Постоянное ожидание «Jarvis» при запуске (1/0). Выбор в интерфейсе запоминается в config/settings.json
WAKE_WORD=1
# Сколько секунд после ответа можно продолжать без «Jarvis»
FOLLOWUP_SECONDS=8
# Глобальная клавиша: короткое нажатие — слушать до паузы, удержание — push-to-talk
HOTKEY=ctrl+alt+j

# --- Распознавание речи (STT) ---
# google — бесплатный онлайн-движок Google; vosk — офлайн; auto — google, без сети vosk
# Свой движок: STT_ENGINE=mypackage.module:MySTT (класс с методом transcribe(pcm, rate) -> str)
STT_ENGINE=auto
# Второй язык: фраза, распознанная латиницей, переспрашивается на нём (none — отключить)
STT_SECOND_LANGUAGE=en-US
# Офлайн-модели Vosk (активатор «Jarvis» и запасной STT): python scripts/download_vosk_model.py
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
VOSK_MODEL_PATH_EN=models/vosk-model-small-en-us-0.15
# Индекс/имя микрофона (пусто = автовыбор). Список: python main.py --list-mics
MIC_DEVICE=

# --- Синтез речи (TTS) ---
# xtts — локальная модель Coqui XTTS-v2 из папки Voice/ (офлайн, на видеокарте; лицензия — только некоммерческая)
#        пока модель грузится (~20 с) или при сбое говорит edge, затем sapi
TTS_XTTS_MODEL_DIR=Voice
# Встроенный голос (список: python main.py --voices; проба: python main.py --say "Текст" --speaker "Viktor Eka")
TTS_XTTS_SPEAKER=Damien Black
# Свой образец голоса WAV 6–30 с — только голос, на который у вас есть права (ваш собственный / с согласия)
TTS_XTTS_SPEAKER_WAV=
# none | jarvis (лёгкое «динамиковое» эхо)
TTS_XTTS_EFFECT=jarvis
# Игровой режим: если видеокарта загружена ≥ N% (игра), фразу говорит облачный голос Edge,
# чтобы не тормозить ни голос, ни игру. 0 — всегда XTTS
TTS_XTTS_GPU_BUSY=40
# edge — нейронные голоса Microsoft (онлайн), sapi — голоса Windows (офлайн), none — без звука
# Свой движок: TTS_ENGINE=mypackage.module:MyTTS (класс с методом speak(text, stop_event, lang))
TTS_ENGINE=edge
TTS_VOICE=ru-RU-DmitryNeural
TTS_VOICE_EN=en-GB-RyanNeural
# Мужской резервный голос, если основной не ответил (говорит и по-русски)
TTS_VOICE_BACKUP=en-US-AndrewMultilingualNeural
# Темп и тон, например -4Hz для более низкого «голоса ИИ». Внимание: для ru-RU-DmitryNeural
# любые изменения заметно повышают число отказов сервиса (тогда звучит резервный голос)
TTS_RATE=+0%
TTS_PITCH=+0Hz
